{
  "id": "ikamet_first",
  "title": "First short-term residence permit (İkamet) for Sabancı University incoming exchange students",
  "status": "verified",
  "version": "1.0.0",
  "aliases": ["ikamet", "ikamet izni", "residence permit", "oturma izni", "short-term residence permit",
             "short term residence permit", "first residence permit", "residence permit application"],
  "qualifiers": ["first", "apply", "application", "exchange", "arrived", "basvuru", "basvurusu", "ilk"],
  "scope": "Sabancı University incoming exchange student, 18+, staying 3 months or longer, first short-term residence permit application in Türkiye.",
  "excluded": [
    "extensions",
    "transfers",
    "minors",
    "family permits",
    "work permits",
    "degree-student variants"
  ],
  "scope_conditions": [
    {
      "op": "eq",
      "field": "institution",
      "value": "Sabancı University"
    },
    {
      "op": "eq",
      "field": "applicant_type",
      "value": "incoming_exchange"
    },
    {
      "op": "eq",
      "field": "application_kind",
      "value": "first"
    },
    {
      "op": "eq",
      "field": "permit_type",
      "value": "short_term"
    },
    {
      "op": "gte",
      "field": "age",
      "value": 18
    },
    {
      "op": "is_true",
      "field": "exchange_student"
    },
    {
      "op": "gte",
      "field": "planned_stay_months",
      "value": 3
    }
  ],
  "sections": [
    {
      "id": "eligibility",
      "title": "Eligibility and legal stay",
      "order": 1,
      "delegate": true
    },
    {
      "id": "passport_photo",
      "title": "Passport, entry pages and photo",
      "order": 2,
      "delegate": true
    },
    {
      "id": "application_fees",
      "title": "Online application, form and fees",
      "order": 3,
      "delegate": true
    },
    {
      "id": "student_insurance",
      "title": "Student status and health insurance",
      "order": 4,
      "delegate": true
    },
    {
      "id": "address_declaration",
      "title": "Address, contact and declaration",
      "order": 5,
      "delegate": true
    },
    {
      "id": "iro_submission",
      "title": "IRO pre-verification and submission",
      "order": 6,
      "delegate": true,
      "later": true
    },
    {
      "id": "guardrails",
      "title": "Authority and after submission",
      "order": 7,
      "delegate": false
    }
  ],
  "stages": [
    {
      "id": "official_application",
      "title": "Online e-İkamet application",
      "requires": [
        "R001",
        "R002",
        "R003",
        "R004",
        "R005",
        "R006"
      ]
    },
    {
      "id": "fingerprint",
      "title": "Fingerprint / GI step",
      "requires": [
        "R005",
        "R007"
      ]
    },
    {
      "id": "iro_preverification",
      "title": "Send scans to IRO for pre-verification",
      "requires": [
        "R020"
      ]
    },
    {
      "id": "iro_submission",
      "title": "Physical file submission at IRO",
      "requires": [
        "R023",
        "R024",
        "R025",
        "R026"
      ]
    }
  ],
