  "documents": [
    {
      "doc_type": "student_enrollment_certificate",
      "description": "Student certificate (öğrenci belgesi) issued by the university",
      "extracts": [
        {
          "field": "holder_name"
        },
        {
          "field": "student_id"
        },
        {
          "field": "institution"
        },
        {
          "field": "student_certificate_issue_date",
          "from_field": "issue_date"
        },
        {
          "field": "exchange_student"
        },
        {
          "field": "program_start_date"
        },
        {
          "field": "program_end_date"
        }
      ]
    },
    {
      "doc_type": "health_insurance_certificate",
      "description": "Health insurance policy or certificate",
      "extracts": [
        {
          "field": "holder_name"
        },
        {
          "field": "insurance_insurer",
          "from_field": "insurer"
        },
        {
          "field": "insurance_policy_number",
          "from_field": "policy_number"
        },
        {
          "field": "insurance_start_date",
          "from_field": "coverage_start_date"
        },
        {
          "field": "insurance_end_date",
          "from_field": "coverage_end_date"
        },
        {
          "field": "passport_or_foreign_id"
        }
      ]
    },
    {
      "doc_type": "ikamet_application_form",
      "description": "IKAMET / online residence-permit application form",
      "extracts": [
        {
          "field": "holder_name",
          "from_field": "applicant_name"
        },
        {
          "field": "passport_or_foreign_id"
        },
        {
          "field": "permit_type"
        },
        {
          "field": "application_number"
        },
        {
          "field": "requested_start_date"
        },
        {
          "field": "requested_end_date"
        },
        {
          "field": "requested_permit_end_date",
          "from_field": "requested_end_date"
        }
      ]
    },
    {
      "doc_type": "passport_identity_page",
      "description": "Passport identity page",
      "extracts": [
        {
          "field": "holder_name"
        },
        {
          "field": "passport_or_foreign_id",
          "from_field": "passport_number"
        },
        {
          "field": "nationality"
        },
        {
          "field": "passport_expiry_date",
          "from_field": "expiry_date"
        },
        {
          "field": "passport_id_page_present",
          "from_field": "identity_page_present"
        }
      ]
    },
    {
      "doc_type": "turkiye_entry_stamp",
      "description": "Latest Türkiye entry-stamp page",
      "extracts": [
        {
          "field": "entry_stamp_present"
        },
        {
          "field": "turkey_entry_page_present",
          "from_field": "entry_stamp_present"
        },
        {
          "field": "latest_entry_date",
          "requires_confirmation": true
        }
      ]
    },
    {
      "doc_type": "declaration_control_document",
      "description": "Sabancı declaration control document",
      "extracts": [
        {
          "field": "holder_name"
        },
        {
          "field": "declaration_control_document_present",
          "from_field": "document_present"
        },
        {
          "field": "declaration_control_document_signed",
          "from_field": "signed"
        }
      ]
    },
    {
      "doc_type": "card_fee_receipt",
      "description": "Residence-permit card / document fee payment receipt",
      "extracts": [
        {
          "field": "holder_name"
        },
        {
          "field": "fee_receipt_present",
          "from_field": "receipt_present"
        },
        {
          "field": "receipt_payment_date",
          "from_field": "payment_date"
        },
        {
          "field": "receipt_reference_number",
          "from_field": "reference_number"
        },
        {
          "field": "receipt_amount",
          "from_field": "amount"
        }
      ]
    }
  ],
  "derived": [
    {
      "field": "current_date",
      "op": "today"
    },
    {
      "field": "planned_stay_months",
      "op": "months_between",
      "args": [
        "program_start_date",
        "program_end_date"
      ]
    },
    {
      "field": "exchange_program_evidence_present",
      "op": "true_if_all",
      "args": [
        "exchange_student",
        "program_start_date",
        "program_end_date"
      ]
    },
    {
      "field": "student_certificate_present",
      "op": "document_complete",
      "doc_type": "student_enrollment_certificate",
      "required": [
        "holder_name",
        "student_id",
        "institution",
        "issue_date"
      ]
    },
    {
      "field": "application_form_generated",
      "op": "document_complete",
      "doc_type": "ikamet_application_form",
      "required": [
        "applicant_name",
        "passport_or_foreign_id",
        "requested_start_date",
        "requested_end_date"
      ]
    }
  ],
