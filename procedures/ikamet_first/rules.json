  },
  {
    "rule_id": "R006",
    "name": "passport_validity_buffer",
    "section": "passport_photo",
    "description": "Passport validity must extend at least 60 days beyond the requested residence-permit end date.",
    "category": "date_constraint",
    "severity": "blocking",
    "condition": {
      "op": "gte",
      "field": "passport_expiry_date",
      "other_field": "requested_permit_end_date",
      "offset_days": 60
    },
    "depends_on": [],
    "source_ids": [
      "SAB_EXCHANGE_OVERVIEW",
      "GOV_FAQ"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "",
    "legacy_condition": "passport_expiry_date >= requested_permit_end_date + 60 days"
  },
  {
