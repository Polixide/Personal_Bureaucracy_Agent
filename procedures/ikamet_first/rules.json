[
  {
    "rule_id": "R001",
    "name": "exchange_stay_requires_ikamet",
    "section": "eligibility",
    "description": "Incoming Sabancı exchange students staying 3 months or longer enter the residence-permit workflow.",
    "category": "eligibility",
    "severity": "blocking",
    "condition": {
      "op": "all",
      "args": [
        {
          "op": "is_true",
          "field": "exchange_student"
        },
        {
          "op": "gte",
          "field": "planned_stay_months",
          "value": 3
        }
      ]
    },
    "depends_on": [],
    "source_ids": [
      "SAB_EXCHANGE_OVERVIEW"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "",
    "legacy_condition": "exchange_student == true AND planned_stay_months >= 3"
  },
  {
    "rule_id": "R002",
    "name": "permit_type_short_term",
    "section": "eligibility",
    "description": "For the scoped Sabancı incoming exchange-student case, the workflow uses a short-term residence permit.",
    "category": "eligibility",
    "severity": "blocking",
    "condition": {
      "op": "eq",
