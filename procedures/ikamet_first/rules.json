    "legacy_condition": "permit_type == 'short_term'"
  },
  {
    "rule_id": "R003",
    "name": "application_after_entry",
    "section": "eligibility",
    "description": "A first application is started only after entry into Türkiye; Sabancı instructs entry with passport.",
    "category": "eligibility",
    "severity": "blocking",
    "condition": {
      "op": "all",
      "args": [
        {
          "op": "is_true",
          "field": "is_in_turkiye"
        },
        {
          "op": "is_true",
          "field": "entered_with_passport"
        }
      ]
    },
    "depends_on": [],
    "source_ids": [
      "SAB_EXCHANGE_OVERVIEW"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "",
    "legacy_condition": "is_in_turkiye == true AND entered_with_passport == true"
  },
  {
    "rule_id": "R004",
    "name": "apply_before_legal_stay_expiry",
    "section": "eligibility",
    "description": "The online first application must be completed before visa/visa-exemption/current legal stay expires.",
    "category": "deadline",
    "severity": "blocking",
    "condition": {
      "op": "lte",
      "field": "application_date",
      "other_field": "legal_stay_expiry_date"
    },
    "depends_on": [],
    "source_ids": [
      "SAB_EXCHANGE_OVERVIEW",
      "METU_RESIDENCE_2026"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "medium",
    "notes": "",
    "legacy_condition": "application_date <= legal_stay_expiry_date"
  },
  {
    "rule_id": "R005",
