  {
    "rule_id": "R015",
    "name": "insurance_covers_period",
    "section": "student_insurance",
    "description": "Health-insurance coverage must cover the requested permit period unless a valid official exemption/alternative applies.",
    "category": "insurance",
    "severity": "blocking",
    "condition": {
      "op": "any",
      "args": [
        {
          "op": "is_true",
          "field": "insurance_exempt"
        },
        {
          "op": "all",
          "args": [
            {
              "op": "is_true",
              "field": "insurance_valid_for_ikamet"
            },
            {
              "op": "lte",
              "field": "insurance_start_date",
              "other_field": "requested_start_date"
            },
            {
              "op": "gte",
              "field": "insurance_end_date",
              "other_field": "requested_end_date"
            }
          ]
        }
      ]
    },
    "depends_on": [
      "R016"
    ],
    "source_ids": [
      "GOV_SHORT_TERM_FORM_2026",
      "GOV_RESIDENCE_TYPES",
      "SAB_EXCHANGE_OVERVIEW",
      "METU_RESIDENCE_2026"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "The milestone-1 app also used a code-only 'scoped' variant; it was dropped on 2026-11-18 (docs/migration_plan.md).",
    "legacy_condition": "insurance_exempt == true OR (insurance_valid_for_ikamet == true AND insurance_start_date <= requested_start_date AND insurance_end_date >= requested_end_date)"
  },
