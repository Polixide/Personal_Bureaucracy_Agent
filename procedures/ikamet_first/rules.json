    "status": "verified",
    "volatility": "low",
    "notes": "",
    "legacy_condition": "application_form_generated == true AND application_form_signed == true"
  },
  {
    "rule_id": "R008",
    "name": "passport_copy_pages_complete",
    "section": "passport_photo",
    "description": "Required passport copy pages must be present; Sabancı also requires the Türkiye entry page and visa page if applicable.",
    "category": "document",
    "severity": "blocking",
    "condition": {
      "op": "all",
      "args": [
        {
          "op": "is_true",
          "field": "passport_id_page_present"
        },
        {
          "op": "is_true",
          "field": "turkey_entry_page_present"
