    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "",
    "legacy_condition": "passport_id_page_present == true AND turkey_entry_page_present == true AND (visa_required == false OR visa_page_present == true)"
  },
  {
    "rule_id": "R009",
    "name": "biometric_photo_current",
    "section": "passport_photo",
    "description": "The biometric photo must be within 6 months and ICAO-compliant.",
    "category": "document",
    "severity": "blocking",
    "condition": {
      "op": "all",
      "args": [
        {
          "op": "gte",
          "field": "photo_age_months",
          "value": 0
        },
        {
          "op": "lte",
          "field": "photo_age_months",
          "value": 6
        },
        {
          "op": "is_true",
          "field": "biometric_photo"
        },
        {
          "op": "is_true",
          "field": "icao_compliant"
        }
      ]
    },
    "depends_on": [],
    "source_ids": [
      "GOV_SHORT_TERM_FORM_2026",
      "SAB_EXCHANGE_CURRENT"
    ],
    "version": "1.0",
    "status": "verified",
    "volatility": "low",
    "notes": "Lower bound 0 reproduces the milestone-1 engine (a photo age cannot be negative).",
    "legacy_condition": "photo_age_months <= 6 AND biometric_photo == true AND icao_compliant == true"
  },
